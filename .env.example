# Copy to infra/secrets/{control,worker}.enc.env and encrypt with sops. Never commit plaintext.

# Network
PUBLIC_HOSTNAME=hooks.example.com      # Caddy: GitHub webhook delivery only
PRIVATE_IP=10.0.0.1                    # this server's private-network address
CONTROL_PRIVATE_IP=10.0.0.1
WORKER_PRIVATE_IP=10.0.0.2

# Postgres (control server)
POSTGRES_PASSWORD=change-me

# GitHub: one App per role, keys in GITHUB_APP_KEY_DIR/<role>.pem
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_IDS={"orchestrator": 0, "engineer": 0, "reviewer": 0}
GITHUB_APP_KEY_DIR=/etc/agent-company/github-apps
# Who may hand work to the agents (agent-ready / needs-breakdown labels): you, plus the
# orchestrator App's bot login so tickets the tech lead splits out stay trusted.
TRUSTED_LABELERS=["your-github-login", "your-orchestrator-app[bot]"]
# Whose approvals and /answer comments count.
HUMAN_APPROVERS=["your-github-login"]

# Model proxy (worker server). Only LiteLLM ever sees ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MASTER_KEY=sk-litellm-change-me

# Slack approvals and alerts
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#agent-team

# Tracing (optional until Langfuse is deployed)
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sandboxes (worker server). runsc = gVisor; use runc only on a dev machine.
SANDBOX_RUNTIME=runsc
SANDBOX_DISK_QUOTA=            # e.g. 20G (needs overlay2 on xfs with pquota)
MAX_SANDBOXES=4
WORKER_ID=worker-1

# Spend: team-wide daily ceiling in USD (500 in Phase 3). Per-agent caps live in the agents table.
# Keep infra/worker/litellm.yaml max_budget in step. Raise later with `orchestrator.admin set-ceiling`.
TEAM_DAILY_CEILING_USD=250
TIMEZONE=America/Chicago
